# PRODUCTION — copy to .env.production
# Build with: npm run build (Vite uses .env.production by default in build mode)
# Or explicitly:  npm run build -- --mode production

# ── API location / network-tab cloaking ──
# RECOMMENDED: leave VITE_API_URL BLANK and serve the API on the SAME origin as
# the site via a reverse proxy (see deploy/nginx.conf.example). Same-origin calls
# show up in DevTools as first-party requests to your own domain instead of an
# obvious, separate "api.damkemon.com" backend — and there are no CORS preflights.
VITE_API_URL=

# Opaque path prefix. Defaults to "/api" if unset. Set to something non-obvious
# and have the reverse proxy rewrite it back to the backend's /api, so the shipped
# bundle never advertises "/api/search", "/api/products", etc.
VITE_API_BASE=/_dk

# NOTE: the browser network tab can never be fully hidden — any request the page
# makes is visible to the user. The above only makes calls look first-party and
# stops the bundle from documenting your route structure. Real protection is
# server-side (admin endpoints require auth, search is rate-limited) and already
# in place.

# Cross-origin fallback: only if the backend really must live on another host.
# Then the API is unavoidably visible as a separate origin in the network tab.
# VITE_API_URL=https://api.damkemon.com

# Optional: identifies the build for analytics / Sentry
VITE_ENV_LABEL=production

# Optional: a Sentry DSN, GA ID, Plausible domain, etc. as you wire them up
# VITE_SENTRY_DSN=
# VITE_GA_ID=
# VITE_PLAUSIBLE_DOMAIN=damkemon.com
