{"nodes": [{"id": "landing_standout_changes_protectshowcase", "label": "ProtectShowcase Surfacing on Homepage", "file_type": "concept", "source_file": "LANDING_STANDOUT_CHANGES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ProtectShowcase (animated anti-scam live risk check) was already built but never rendered anywhere. Surfaced high on Home.jsx as the single strongest trust differentiator vs price-only BD competitors (MuthoPhone, PriceMama, BDStall). Demonstrates flagging bKash-personal-number and below-market scam patterns."}, {"id": "landing_standout_changes_bangla_brand_line", "label": "Bangla Brand Line in Hero", "file_type": "concept", "source_file": "LANDING_STANDOUT_CHANGES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Added the Bangla phrase \u09a6\u09be\u09ae \u0995\u09c7\u09ae\u09a8? ('how's the price?') under the H1. The brand name is the everyday Bangla phrase for 'what's the price?' \u2014 a memorable local asset. Renders crisply because the Hind Siliguri Bangla font is already loaded."}, {"id": "landing_standout_changes_trust_microproofs", "label": "Trust Micro-proofs Under Hero Search", "file_type": "rationale", "source_file": "LANDING_STANDOUT_CHANGES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compact row at point of action: 'Real prices, never fake \u00b7 Scam-risk checked \u00b7 Free for shoppers'. Trust signals placed next to the primary action lift buyer confidence (conversion research). Reuses already-imported BadgeCheck, ShieldCheck, Sparkles icons."}, {"id": "landing_standout_changes_trust_first_reorder", "label": "Trust-first Emphasis Reorder", "file_type": "rationale", "source_file": "LANDING_STANDOUT_CHANGES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Page reordered to price proof -> trust/anti-scam (Protect) -> how it works -> social proof -> FAQ. Trust is the #1 reason BD shoppers hesitate post-Evaly, so trust is no longer buried."}, {"id": "landing_standout_changes_home_jsx", "label": "Home.jsx (landing page target)", "file_type": "code", "source_file": "LANDING_STANDOUT_CHANGES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "landing_standout_changes_protectshowcase", "target": "landing_standout_changes_home_jsx", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "LANDING_STANDOUT_CHANGES.md", "source_location": null, "weight": 1.0}, {"source": "landing_standout_changes_bangla_brand_line", "target": "landing_standout_changes_home_jsx", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "LANDING_STANDOUT_CHANGES.md", "source_location": null, "weight": 1.0}, {"source": "landing_standout_changes_trust_microproofs", "target": "landing_standout_changes_home_jsx", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "LANDING_STANDOUT_CHANGES.md", "source_location": null, "weight": 1.0}, {"source": "landing_standout_changes_trust_first_reorder", "target": "landing_standout_changes_home_jsx", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "LANDING_STANDOUT_CHANGES.md", "source_location": null, "weight": 1.0}, {"source": "landing_standout_changes_bangla_brand_line", "target": "index_google_fonts", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "LANDING_STANDOUT_CHANGES.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "landing_trust_first_redesign", "label": "Trust-first Landing Redesign of Home.jsx", "nodes": ["landing_standout_changes_protectshowcase", "landing_standout_changes_trust_mi